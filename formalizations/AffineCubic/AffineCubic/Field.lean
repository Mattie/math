import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Polynomial.Eisenstein.Basic
import Mathlib.RingTheory.Polynomial.GaussLemma
import Mathlib.Algebra.Algebra.Hom.Rat
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic

namespace OAI.AffineCubic.Field
open Polynomial
open scoped IntermediateField
noncomputable section

/-- The positive real cube root of two, in conventional real-power notation. -/
def root : ℝ := (2 : ℝ) ^ (1 / 3 : ℝ)

theorem root_pos : 0 < root := Real.rpow_pos_of_pos (by norm_num) _

theorem root_cube : root ^ 3 = 2 := by
  simpa [root, one_div] using
    (Real.rpow_inv_natCast_pow (x := 2) (n := 3) (by norm_num) (by norm_num))

/-- Eisenstein at two certifies the degree, without a degree hypothesis. -/
theorem cubic_irreducible_int : Irreducible (X ^ 3 - C (2:ℤ)) := by
  have hm : (X ^ 3 - C (2:ℤ)).Monic := monic_X_pow_sub_C _ (by norm_num)
  refine Polynomial.IsEisensteinAt.irreducible (𝓟 := Ideal.span {(2:ℤ)}) ?_ ?_ hm.isPrimitive ?_
  · constructor
    · rw [hm.leadingCoeff, Ideal.mem_span_singleton]
      norm_num
    · intro n hn
      rw [natDegree_X_pow_sub_C] at hn
      interval_cases n <;> norm_num [coeff_sub, coeff_X_pow, coeff_C, Ideal.mem_span_singleton]
    · norm_num [Ideal.span_singleton_pow, Ideal.mem_span_singleton, coeff_sub, coeff_X_pow, coeff_C]
  · exact (Ideal.span_singleton_prime (by norm_num : (2:ℤ) ≠ 0)).mpr (by norm_num)
  · rw [natDegree_X_pow_sub_C]
    norm_num

theorem cubic_irreducible : Irreducible (X ^ 3 - C (2:ℚ)) := by
  have hm : (X ^ 3 - C (2:ℤ)).Monic := monic_X_pow_sub_C _ (by norm_num)
  have h := (hm.irreducible_iff_irreducible_map_fraction_map (K := ℚ)).mp cubic_irreducible_int
  norm_num at h ⊢
  exact h

theorem root_minpoly : minpoly ℚ root = X ^ 3 - C (2:ℚ) := by
  have he : aeval root (X ^ 3 - C (2:ℚ)) = 0 := by simp [root_cube]
  have h := minpoly.eq_of_irreducible cubic_irreducible he
  rw [(monic_X_pow_sub_C (2:ℚ) (by norm_num : 3 ≠ 0)).leadingCoeff] at h
  simpa using h.symm

theorem root_integral_rat : IsIntegral ℚ root := by
  refine ⟨X ^ 3 - C (2:ℚ), monic_X_pow_sub_C _ (by norm_num), ?_⟩
  simp [root_cube]

/-- The actual subfield of the reals generated by the cube root. -/
abbrev F := IntermediateField.adjoin ℚ ({root} : Set ℝ)

instance : NumberField F := by
  let := IntermediateField.adjoin.finiteDimensional root_integral_rat
  exact NumberField.of_module_finite ℚ F

theorem degree : Module.finrank ℚ F = 3 := by
  rw [IntermediateField.adjoin.finrank root_integral_rat, root_minpoly, natDegree_X_pow_sub_C]

def r : F := IntermediateField.AdjoinSimple.gen ℚ root

def sigma0 : F →ₐ[ℚ] ℂ :=
  ((algebraMap ℝ ℂ).comp F.subtype).toRatAlgHom

@[simp] theorem sigma0_r : sigma0 r = (root : ℂ) := rfl

theorem r_cube : r ^ 3 = 2 := by
  apply Subtype.ext
  exact root_cube

theorem r_integral : IsIntegral ℤ r := by
  apply IsIntegral.of_pow (n := 3) (by norm_num)
  rw [r_cube]
  exact isIntegral_algebraMap

end
end OAI.AffineCubic.Field



