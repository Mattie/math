theorem OAI.Arctangent.rational_arctan_irrationality_and_bound (r : Rat) (hr : Ne r (OfNat.ofNat 0)) :
  And (Irrational (Real.arctan (Rat.cast r)))
    (forall (nu : Real),
    LT.lt (OfNat.ofNat 2) nu → Exists
      (fun (Q : Int) =>
      And (LE.le (OfNat.ofNat 2) Q)
        (forall (p q : Int),
        LE.le Q q → LE.le (HPow.hPow (Int.cast q) (Neg.neg nu))
          (abs (HSub.hSub (Real.arctan (Rat.cast r)) (HDiv.hDiv (Int.cast p) (Int.cast q))))))) :=
  _

