theorem OAI.Imaginary.normalized_arctan_sqrt_two_irrationality_and_bound :
  And (Irrational (HDiv.hDiv (Real.arctan (Real.sqrt (OfNat.ofNat 2))) (Real.sqrt (OfNat.ofNat 2))))
    (forall (nu : Real),
    LT.lt (OfNat.ofNat 2) nu → Exists
      (fun (Q : Int) =>
      And (LE.le (OfNat.ofNat 2) Q)
        (forall (p q : Int),
        LE.le Q q → LE.le (HPow.hPow (Int.cast q) (Neg.neg nu))
          (abs
            (HSub.hSub (HDiv.hDiv (Real.arctan (Real.sqrt (OfNat.ofNat 2))) (Real.sqrt (OfNat.ofNat 2)))
              (HDiv.hDiv (Int.cast p) (Int.cast q))))))) :=
  _

